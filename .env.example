APP_NAME="OurCloud Louvor"
APP_VERSION=1.0.0-rc94
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=/absolute/path/to/database/database.sqlite
# Produção com PostgreSQL:
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=sgml
# DB_USERNAME=sgml
# DB_PASSWORD=
# DB_SSLMODE=prefer

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@example.org"
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/integrations/google/callback
GOOGLE_CALENDAR_ID=primary

# Usados pelo instalador/seed inicial quando necessário.
SGML_ADMIN_NAME=Administrador
SGML_ADMIN_EMAIL=admin@example.org
SGML_ADMIN_PASSWORD=
SGML_ORGANIZATION_NAME="Igreja Local"
SGML_ORGANIZATION_SLUG=igreja-local

SGML_BACKUP_PATH=/var/backups/sgml/database
SGML_PG_DUMP_BINARY=/usr/bin/pg_dump
SGML_PG_RESTORE_BINARY=/usr/bin/pg_restore
SGML_BACKUP_TIMEOUT=300
SGML_BACKUP_MAX_FILES=30
SGML_BACKUP_UPLOAD_MAX_KB=524288
SGML_RESTORE_REQUEST_PATH=/var/lib/sgml/restore-requests
SGML_RESTORE_STATUS_PATH=/var/lib/sgml/restore-status
SGML_RESTORE_DISPATCHER=/usr/local/sbin/sgml-web-restore-dispatch
