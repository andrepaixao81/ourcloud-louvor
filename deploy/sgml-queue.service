[Unit]
Description=SGML Laravel Queue Worker
After=network-online.target php8.3-fpm.service
Wants=network-online.target

[Service]
Type=simple
User=sgml
Group=sgml
WorkingDirectory=/var/www/sgml
ExecStart=/usr/bin/php8.3 artisan queue:work database --sleep=3 --tries=4 --timeout=120 --max-time=3600
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=360

[Install]
WantedBy=multi-user.target
